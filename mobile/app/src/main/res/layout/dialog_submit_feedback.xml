<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit App Feedback"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerVertical="false"
            android:layout_alignParentLeft="true"/>

        <!-- Dismiss Cross Action Button Layer -->
        <ImageView
            android:id="@+id/btnDismissDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentRight="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:id="@+id/dialogContentArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/dialogTitle"
            android:layout_marginTop="20dp">

            <!-- Feedback Multiline Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type your feedback here...">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top|left"
                    android:inputType="textMultiLine"
                    android:textColor="@color/text_dark"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbars="vertical"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnDialogActionSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="Submit Feedback"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
